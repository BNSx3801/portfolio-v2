# Email delivery for the "Let's have coffee?" note form (app/api/note/route.ts).
# RESEND_API_KEY is provisioned by the Resend integration on Vercel (vercel env pull).
RESEND_API_KEY=
# Optional. Where notes land (defaults to the site contact email) and the sender identity
# (defaults to Resend's shared onboarding sender; use your own once a domain is verified).
NOTES_TO_EMAIL=
NOTES_FROM_EMAIL=
